#include <iostream>
using namespace std;
int main() {
    int r1 = 2, c1 = 2, r2 = 2, c2 = 2;
    int a[2][2] = {{1, 2}, {3, 4}};
    int b[2][2] = {{5, 6}, {7, 8}};
    int sum[2][2], mul[2][2];
 
    // Addition
    for (int i = 0; i < r1; i++)
        for (int j = 0; j < c1; j++)
            sum[i][j] = a[i][j] + b[i][j];
 
    // Multiplication
    for (int i = 0; i < r1; i++)
        for (int j = 0; j < c2; j++) {
            mul[i][j] = 0;
            for (int k = 0; k < c1; k++)
                mul[i][j] += a[i][k] * b[k][j];
        }
 
    cout << "Sum:\n";
    for (int i = 0; i < r1; i++) { for (int j = 0; j < c1; j++) cout << sum[i][j] << " "; cout << endl; }
 
    cout << "Product:\n";
    for (int i = 0; i < r1; i++) { for (int j = 0; j < c2; j++) cout << mul[i][j] << " "; cout << endl; }
