#include <iostream>
using namespace std;
int main() {
    int n, original, remainder, result = 0;
    cout << "Enter a 3-digit number: ";
    cin >> n;
    original = n;
    while (n != 0) {
        remainder = n % 10;
        result += remainder * remainder * remainder;
        n /= 10;
    }
    if (result == original)
        cout << original << " is an Armstrong number\n";
    else
        cout << original << " is not an Armstrong number\n";
    return 0;
}
