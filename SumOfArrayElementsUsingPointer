#include <iostream>
using namespace std;
int main() {
    int n;
    cout << "Enter size of array: ";
    cin >> n;
    int arr[100];
    cout << "Enter elements: ";
    for (int i = 0; i < n; i++) cin >> arr[i];
 
    int *p = arr, sum = 0;
    for (int i = 0; i < n; i++) { sum += *p; p++; }
    cout << "Sum = " << sum << endl;
    return 0;
}
