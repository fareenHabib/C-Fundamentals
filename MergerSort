#include <iostream>
using namespace std;
int main() {
    int a[] = {1, 3, 5, 7};
    int b[] = {2, 4, 6, 8, 10};
    int n1 = 4, n2 = 5;
    int merged[20];
    int i = 0, j = 0, k = 0;
 
    while (i < n1 && j < n2)
        merged[k++] = (a[i] <= b[j]) ? a[i++] : b[j++];
    while (i < n1) merged[k++] = a[i++];
    while (j < n2) merged[k++] = b[j++];
 
    cout << "Merged sorted array: ";
    for (int m = 0; m < k; m++) cout << merged[m] << " ";
    cout << endl;
    return 0;
}
