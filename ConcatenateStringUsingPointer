#include <iostream>
using namespace std;
int main() {
    char str1[50] = "Computer ";
    char str2[] = "Science";
    char *p1 = str1, *p2 = str2;
 
    while (*p1 != '\0') p1++;
    while (*p2 != '\0') { *p1 = *p2; p1++; p2++; }
    *p1 = '\0';
 
    cout << "Concatenated string: " << str1 << endl;
    return 0;
}
